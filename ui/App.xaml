<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MyHotkey.App"
             StartupUri="MainWindow.xaml">
  <!-- Deliberately empty. Stock controls, stock theme.

       The first version restyled everything by hand and earned a classic WPF
       bug for it: an application-wide implicit TextBlock style bleeds into
       control templates and overrides the foreground a button sets for its own
       text - which is how a blue button ended up with near-black text. Stock
       controls also track the system theme and high-contrast for free. -->
</Application>
