<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MyHotkey.RuleEditor"
        Title="Правило" Width="560" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="22">

    <!-- shortcut recorder -->
    <TextBlock Text="Сочетание" Style="{StaticResource FieldLabel}"/>
    <Button x:Name="RecordBtn" Style="{StaticResource Btn}" Click="Record_Click"
            HorizontalContentAlignment="Left" Padding="12,11" Margin="0,0,0,4">
      <TextBlock x:Name="TriggerText" Text="Нажмите, чтобы записать"
                 FontFamily="Consolas" FontSize="15"/>
    </Button>
    <TextBlock x:Name="RecordHint" Style="{StaticResource Caption}" Margin="2,0,0,16"
               Text="Ловятся любые сочетания, включая Alt+Tab и Win+R."/>

    <!-- when -->
    <TextBlock Text="Срабатывать" Style="{StaticResource FieldLabel}"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
      <RadioButton x:Name="OnPress"   Content="при нажатии" GroupName="when" IsChecked="True"/>
      <RadioButton x:Name="OnRelease" Content="при отпускании" GroupName="when"/>
    </StackPanel>

    <!-- action -->
    <TextBlock Text="Действие" Style="{StaticResource FieldLabel}"/>
    <ComboBox x:Name="ActionKindBox" SelectionChanged="ActionKind_Changed" Margin="0,0,0,10">
      <ComboBoxItem Content="Отправить сочетание"/>
      <ComboBoxItem Content="Напечатать текст"/>
      <ComboBoxItem Content="Запустить программу"/>
      <ComboBoxItem Content="Переключить раскладку"/>
      <ComboBoxItem Content="Проглотить клавишу"/>
    </ComboBox>

    <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,16">
      <Grid>
        <!-- combo -->
        <StackPanel x:Name="ComboPanel">
          <TextBlock Text="Какие клавиши отправить" Style="{StaticResource FieldLabel}"/>
          <Button x:Name="RecordActionBtn" Style="{StaticResource Btn}" Click="RecordAction_Click"
                  HorizontalContentAlignment="Left" Padding="12,9" Margin="0,0,0,4">
            <TextBlock x:Name="ActionKeysText" Text="Нажмите, чтобы записать"
                       FontFamily="Consolas" FontSize="14"/>
          </Button>
          <TextBlock Style="{StaticResource Caption}"
                     Text="Например Alt+Left — «назад», или Ctrl+Shift — смена раскладки."/>
        </StackPanel>

        <!-- text -->
        <StackPanel x:Name="TextPanel" Visibility="Collapsed">
          <TextBlock Text="Текст" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="TextBoxValue" AcceptsReturn="True" TextWrapping="Wrap" Height="86"
                   VerticalScrollBarVisibility="Auto"/>
          <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                     Text="Печатается как есть, раскладка значения не имеет."/>
        </StackPanel>

        <!-- launch -->
        <StackPanel x:Name="LaunchPanel" Visibility="Collapsed">
          <TextBlock Text="Программа или ссылка" Style="{StaticResource FieldLabel}"/>
          <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox" Grid.Column="0"/>
            <Button Grid.Column="1" Content="Обзор…" Style="{StaticResource Btn}"
                    Margin="8,0,0,0" Click="Browse_Click"/>
          </Grid>
          <TextBlock Text="Аргументы" Style="{StaticResource FieldLabel}"/>
          <TextBox x:Name="ArgsBox"/>
        </StackPanel>

        <!-- layout -->
        <StackPanel x:Name="LayoutPanel" Visibility="Collapsed">
          <TextBlock Text="Направление" Style="{StaticResource FieldLabel}"/>
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="LayoutNext" Content="следующая" GroupName="layout" IsChecked="True"/>
            <RadioButton x:Name="LayoutPrev" Content="предыдущая" GroupName="layout"/>
          </StackPanel>
          <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="Переключает напрямую, не подделывая Ctrl+Shift. Работает независимо от того, какое сочетание назначено на смену раскладки в Windows."/>
        </StackPanel>

        <!-- block -->
        <StackPanel x:Name="BlockPanel" Visibility="Collapsed">
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                     Text="Клавиша будет проглочена и не дойдёт ни до одного приложения. Так отключают, например, Insert или CapsLock."/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- scope -->
    <TextBlock Text="Где работает" Style="{StaticResource FieldLabel}"/>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <RadioButton x:Name="ScopeAll"    Content="везде" GroupName="scope" IsChecked="True"
                   Checked="Scope_Changed"/>
      <RadioButton x:Name="ScopeOnly"   Content="только в программе" GroupName="scope"
                   Checked="Scope_Changed"/>
      <RadioButton x:Name="ScopeExcept" Content="кроме программы" GroupName="scope"
                   Checked="Scope_Changed"/>
    </StackPanel>
    <TextBox x:Name="AppBox" Margin="0,0,0,4" IsEnabled="False"/>
    <TextBlock Style="{StaticResource Caption}" Margin="2,0,0,16"
               Text="Имя процесса, например chrome.exe"/>

    <!-- name -->
    <TextBlock Text="Название (необязательно)" Style="{StaticResource FieldLabel}"/>
    <TextBox x:Name="NameBox" Margin="0,0,0,20"/>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Отмена" Style="{StaticResource Btn}" Click="Cancel_Click" IsCancel="True"/>
      <Button Content="Сохранить" Style="{StaticResource BtnPrimary}" Click="Save_Click"
              Margin="0" IsDefault="True"/>
    </StackPanel>
  </StackPanel>
</Window>
